# ── Copiá como .env y completá los valores ────

# Django
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=MentorVirtual
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres        # nombre del servicio en Docker Compose
POSTGRES_PORT=5432

# Si el Postgres vive en otra red Docker externa:
# POSTGRES_HOST=nombre_contenedor_externo
# DOCKER_NETWORK=nombre_de_la_red_externa

# APIs externas
# YOUTUBE_API_KEY=AIzaxxxxx
# HF_TOKEN=hf_xxxxxxxxxx

# ── Proveedor de IA (core/ai_providers.py) ────────────────────────────────────
# Descomentá SOLO el bloque del proveedor que vayas a usar. AI_PROVIDER no tiene
# default en el código a propósito — si no lo seteás, el backend falla explícito
# con ImproperlyConfigured en vez de asumir un proveedor por las tuyas.

# Opción 1: Anthropic (Claude)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Opción 2: OpenAI (ChatGPT)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4o-mini

# Opción 3: DeepSeek
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxx
# DEEPSEEK_MODEL=deepseek-chat

# Opción 4: Google Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIzaxxxxx
# GEMINI_MODEL=gemini-2.0-flash

# Opción 5: Ollama (local, gratis — ideal para dev en natu)
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_URL=http://host.docker.internal:11434

# Tokens máximos de salida al generar el plan de un goal (pasos + logros en JSON).
# Default 2048. Si el JSON se corta a la mitad (Unterminated string), subilo.
# GOALS_PLAN_MAX_TOKENS=2048

# CORS (agregar dominio del frontend en prod)
# CORS_ALLOWED_ORIGINS=https://tudominio.com

# Frontend (variables expuestas a React vía Vite — deben empezar con VITE_)
VITE_APP_NAME=Mentor Virtual
VITE_MENTOR_NAME=Pulso

# Email (notificaciones de registro / inscripción a curso)
# Sin configurar, EMAIL_BACKEND por defecto solo imprime el correo en consola —
# no hace falta llenar esto para levantar el entorno local.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Mentor Virtual <noreply@tudominio.com>
# Credenciales reales: pedirlas por canal privado al equipo, NUNCA committear
# un valor real acá ni en docker-compose.yml.
