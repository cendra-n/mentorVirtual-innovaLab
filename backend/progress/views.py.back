"""
progress/views.py

Endpoints para:
  - Completar un paso
  - Registrar video visto
  - Consultar progreso de un goal
  - Consultar streak del usuario
"""
import logging

from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework.permissions import IsAuthenticated
from rest_framework import status

from .db import (
    sp_complete_step,
    sp_get_user_progress,
    sp_register_video_view,
    sp_get_viewed_videos,
    sp_update_streak,
    sp_get_streak,
)
from goals.db import sp_unlock_logro_if_eligible, sp_get_user_logros

logger = logging.getLogger(__name__)


class CompleteStepView(APIView):
    """
    POST /api/progress/steps/<step_id>/complete/
    Body: { "goal_id": 5 }   ← necesario para calcular progreso y logros
    """
    permission_classes = [IsAuthenticated]

    def post(self, request, step_id: int):
        goal_id = request.data.get('goal_id')
        if not goal_id:
            return Response(
                {'error': 'goal_id es obligatorio.'},
                status=status.HTTP_400_BAD_REQUEST,
            )

        user_id = request.user.id

        # Marcar paso
        step_result = sp_complete_step(step_id, user_id)

        # Actualizar streak
        streak = sp_update_streak(user_id)

        # Verificar y desbloquear logros
        new_logros = sp_unlock_logro_if_eligible(goal_id, user_id)

        # Progreso actualizado
        progress = sp_get_user_progress(user_id, goal_id)

        return Response({
            'step':       step_result,
            'progress':   progress,
            'streak':     streak,
            'new_logros': new_logros,
        })


class RegisterVideoViewView(APIView):
    """
    POST /api/progress/videos/<video_id>/view/
    Body: { "step_id": 3 }
    """
    permission_classes = [IsAuthenticated]

    def post(self, request, video_id: int):
        step_id = request.data.get('step_id')
        if not step_id:
            return Response(
                {'error': 'step_id es obligatorio.'},
                status=status.HTTP_400_BAD_REQUEST,
            )

        user_id = request.user.id
        result  = sp_register_video_view(user_id, video_id, step_id)

        # Actualizar streak también al ver un video
        streak = sp_update_streak(user_id)

        return Response({
            'video_view': result,
            'streak':     streak,
        })


class GoalProgressView(APIView):
    """
    GET /api/progress/goals/<goal_id>/
    Progreso completo del usuario en una meta.
    """
    permission_classes = [IsAuthenticated]

    def get(self, request, goal_id: int):
        user_id  = request.user.id
        progress = sp_get_user_progress(user_id, goal_id)

        if not progress:
            return Response(
                {'error': 'Meta no encontrada o sin progreso.'},
                status=status.HTTP_404_NOT_FOUND,
            )

        viewed_videos = sp_get_viewed_videos(user_id, goal_id)

        return Response({
            'progress':      progress,
            'viewed_videos': viewed_videos,
        })


class UserStreakView(APIView):
    """
    GET /api/progress/streak/
    Streak actual del usuario autenticado.
    """
    permission_classes = [IsAuthenticated]

    def get(self, request):
        streak = sp_get_streak(request.user.id)
        return Response(streak)


class UserLogrosView(APIView):
    """
    GET /api/progress/logros/
    Todos los logros del usuario (desbloqueados y pendientes).
    """
    permission_classes = [IsAuthenticated]

    def get(self, request):
        logros = sp_get_user_logros(request.user.id)
        return Response({'logros': logros})
